# ── Ambiente ──────────────────────────────────────
# Em "production" o servidor EXIGE ANTHROPIC_KEY, MONGO_URI e JWT_SECRET
# (sai com erro se faltarem, para nao subir com fallback inseguro)
NODE_ENV=development

# ── Claude / Anthropic ────────────────────────────
# console.anthropic.com -> Settings -> API Keys
ANTHROPIC_KEY=sk-ant-sua-chave-aqui

# ── Banco de dados ────────────────────────────────
# cloud.mongodb.com -> Connect -> Drivers
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/imperioespetos?appName=Cluster0

# ── Servidor ──────────────────────────────────────
PORT=3001

# ── Autenticacao ──────────────────────────────────
# Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-uma-string-aleatoria-de-32-bytes

# URL do painel (usada no CORS). Sem barra no final.
FRONTEND_URL=https://seu-painel.vercel.app

# PINs de acesso (4 digitos). TROQUE os valores padrao.
# Podem ser alterados depois pelo painel em Config -> PINs.
PIN_DONO=0000
PIN_CAIXA=0000
